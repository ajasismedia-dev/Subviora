<UserControl x:Class="Subviora.Desktop.Views.OcrDiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Subviora.Desktop.ViewModels"
             xmlns:vision="clr-namespace:Subviora.Core.Vision;assembly=Subviora.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OcrDiagnosticsViewModel, IsDesignTimeCreatable=False}">

  <Grid Margin="0,0,0,10">
    <Grid.RowDefinitions>
      <!-- Controls Toolbar -->
      <RowDefinition Height="Auto" />
      <!-- Main Content (Preview + Telemetry) -->
      <RowDefinition Height="*" />
      <!-- Status Footer -->
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ===== Controls Toolbar ===== -->
    <Border Grid.Row="0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,14">
      <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

        <!-- Window Selection -->
        <StackPanel Orientation="Vertical" Margin="0,0,16,6">
          <TextBlock Text="Hedef Pencere" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
          <StackPanel Orientation="Horizontal">
            <ComboBox AutomationProperties.AutomationId="Combo_TargetWindow"
                      Width="260" ItemsSource="{Binding AvailableWindows}"
                      SelectedItem="{Binding SelectedWindow, Mode=TwoWay}"
                      DisplayMemberPath="DisplayText">
              <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                  <Setter Property="AutomationProperties.Name" Value="{Binding DisplayText}" />
                </Style>
              </ComboBox.ItemContainerStyle>
            </ComboBox>
            <Button AutomationProperties.AutomationId="Button_RefreshWindows"
                    Style="{StaticResource Button.Secondary}" Content="Yenile"
                    Command="{Binding RefreshWindowsCommand}" Margin="6,0,0,0" Padding="8,4" />
          </StackPanel>
        </StackPanel>

        <!-- Capture Provider -->
        <StackPanel Orientation="Vertical" Margin="0,0,16,6">
          <TextBlock Text="Yakalama Sağlayıcısı" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
          <ComboBox AutomationProperties.AutomationId="Combo_CaptureProvider"
                    Width="160" ItemsSource="{Binding AvailableCaptureProviders}"
                    SelectedItem="{Binding SelectedCaptureProvider, Mode=TwoWay}"
                    DisplayMemberPath="Id">
            <ComboBox.ItemContainerStyle>
              <Style TargetType="ComboBoxItem">
                <Setter Property="AutomationProperties.Name" Value="{Binding Id}" />
              </Style>
            </ComboBox.ItemContainerStyle>
          </ComboBox>
        </StackPanel>

        <!-- OCR Provider -->
        <StackPanel Orientation="Vertical" Margin="0,0,16,6">
          <TextBlock Text="OCR Motoru" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
          <ComboBox AutomationProperties.AutomationId="Combo_OcrProvider"
                    Width="200" ItemsSource="{Binding AvailableOcrProviders}"
                    SelectedItem="{Binding SelectedOcrProvider, Mode=TwoWay}"
                    DisplayMemberPath="DisplayName">
            <ComboBox.ItemContainerStyle>
              <Style TargetType="ComboBoxItem">
                <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
              </Style>
            </ComboBox.ItemContainerStyle>
          </ComboBox>
          <TextBlock Text="{Binding OcrProviderAvailabilityText}" FontSize="11" Margin="0,4,0,0"
                     Foreground="{StaticResource Brush.TextMuted}" MaxWidth="200" TextWrapping="Wrap" />
        </StackPanel>

        <!-- OCR Region Selection -->
        <StackPanel Orientation="Vertical" Margin="0,0,16,6">
          <TextBlock Text="OCR Bölgesi" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
          <ComboBox AutomationProperties.AutomationId="Combo_RegionMode"
                    Width="200" ItemsSource="{Binding AvailableRegionModes}"
                    SelectedItem="{Binding SelectedRegionMode, Mode=TwoWay}"
                    DisplayMemberPath="DisplayName" />
        </StackPanel>

        <!-- Manual Region Coordinates (Visible when Manual Custom mode selected) -->
        <StackPanel Orientation="Vertical" Margin="0,0,16,6"
                    Visibility="{Binding IsManualRegionVisible, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="Özel Koordinatlar (0.0 - 1.0)" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
          <StackPanel Orientation="Horizontal">
            <StackPanel Margin="0,0,4,0">
              <TextBlock Text="X" FontSize="10" Foreground="{StaticResource Brush.TextMuted}" />
              <TextBox AutomationProperties.AutomationId="Input_ManualRegionX"
                       Width="42" Text="{Binding ManualRegionXText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,4,0">
              <TextBlock Text="Y" FontSize="10" Foreground="{StaticResource Brush.TextMuted}" />
              <TextBox AutomationProperties.AutomationId="Input_ManualRegionY"
                       Width="42" Text="{Binding ManualRegionYText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,4,0">
              <TextBlock Text="G" FontSize="10" Foreground="{StaticResource Brush.TextMuted}" />
              <TextBox AutomationProperties.AutomationId="Input_ManualRegionW"
                       Width="42" Text="{Binding ManualRegionWidthText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,4,0">
              <TextBlock Text="Y" FontSize="10" Foreground="{StaticResource Brush.TextMuted}" />
              <TextBox AutomationProperties.AutomationId="Input_ManualRegionH"
                       Width="42" Text="{Binding ManualRegionHeightText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6">
          <Button AutomationProperties.AutomationId="Button_StartCapture"
                  Style="{StaticResource Button.Primary}" Content="Canlı Yakala"
                  Command="{Binding StartCaptureCommand}" Margin="0,0,6,0" Padding="12,6" />
          <Button AutomationProperties.AutomationId="Button_StopCapture"
                  Style="{StaticResource Button.Secondary}" Content="Durdur"
                  Command="{Binding StopCaptureCommand}" Margin="0,0,6,0" Padding="12,6" />
          <Button AutomationProperties.AutomationId="Button_CaptureOnce"
                  Style="{StaticResource Button.Secondary}" Content="Kare Yakala"
                  Command="{Binding CaptureOnceCommand}" Margin="0,0,6,0" Padding="10,6" />
          <Button AutomationProperties.AutomationId="Button_RunOcrOnce"
                  Style="{StaticResource Button.Secondary}" Content="OCR Çalıştır"
                  Command="{Binding RunOcrOnceCommand}" Margin="0,0,6,0" Padding="10,6" />
          <Button AutomationProperties.AutomationId="Button_SaveScreenshot"
                  Style="{StaticResource Button.Secondary}" Content="Görüntüyü Kaydet"
                  Command="{Binding SaveScreenshotCommand}" Margin="0,0,6,0" Padding="10,6" />
          <Button AutomationProperties.AutomationId="Button_RunBenchmark"
                  Style="{StaticResource Button.Secondary}" Content="Benchmark"
                  Command="{Binding RunBenchmarkCommand}" Padding="10,6" />
        </StackPanel>
      </WrapPanel>
    </Border>

    <!-- ===== Main Area: Preview & Telemetry ===== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <!-- Preview Area -->
        <ColumnDefinition Width="*" MinWidth="450" />
        <!-- Telemetry & OCR Output Sidebar -->
        <ColumnDefinition Width="340" />
      </Grid.ColumnDefinitions>

      <!-- Frame Preview Box -->
      <Border Grid.Column="0" Background="#0A0D0E" BorderBrush="{StaticResource Brush.Border}"
              BorderThickness="1" CornerRadius="4" Margin="0,0,12,0" ClipToBounds="True">
        <Grid>
          <!-- Placeholder when no frame -->
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                      Visibility="{Binding HasNoFramePreview, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="&#xE722;" FontFamily="{StaticResource Font.Icons}" FontSize="48"
                       HorizontalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" />
            <TextBlock Text="Henüz bir oyun karesi yakalanmadı." Style="{StaticResource Text.Label}"
                       HorizontalAlignment="Center" Margin="0,10,0,0" />
            <TextBlock Text="Yukarıdan bir pencere seçip 'Canlı Yakala' veya 'Kare Yakala' düğmesine basın."
                       Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.TextMuted}"
                       HorizontalAlignment="Center" Margin="0,4,0,0" />
          </StackPanel>

          <!-- Captured Image Preview & Overlays (Scaled together via Viewbox) -->
          <Viewbox Stretch="Uniform"
                   Visibility="{Binding HasFramePreview, Converter={StaticResource BoolToVisibility}}">
            <Grid Width="{Binding NativeFrameWidth}" Height="{Binding NativeFrameHeight}">
              <!-- Base Captured Frame -->
              <Image AutomationProperties.AutomationId="Image_FramePreview"
                     Source="{Binding FramePreviewImage}" Stretch="Fill" />

              <!-- Active OCR Regions (Profile Subtitles or Manual Custom Region) -->
              <ItemsControl ItemsSource="{Binding ActiveRegionBoxes}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                  <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                  </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Width="{Binding Width}" Height="{Binding Height}">
                      <Rectangle Stroke="#A3E635" StrokeThickness="2" StrokeDashArray="4 2" />
                      <Border Background="#CC15171A" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="4,2" Margin="2">
                        <TextBlock Text="{Binding Label}" Foreground="#A3E635" FontSize="11" FontWeight="SemiBold" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Detected OCR Text Bounding Boxes -->
              <ItemsControl ItemsSource="{Binding DetectedBoundingBoxes}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                  <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                  </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Width="{Binding Width}" Height="{Binding Height}">
                      <Rectangle Stroke="#E3B341" StrokeThickness="1.5" />
                      <Border Background="#E615171A" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="3,1" Margin="1">
                        <TextBlock Text="{Binding Text}" Foreground="#FFE6E8EB" FontSize="10" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Viewbox>

          <!-- Notice Overlay Pill -->
          <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10"
                  Background="#CC161B1E" CornerRadius="3" Padding="8,4">
            <TextBlock Text="AG-02 Yakalama &amp; OCR Denetim Önizlemesi (Oyun Katmanı Değildir)"
                       Foreground="{StaticResource Brush.Accent}" FontSize="11" FontWeight="SemiBold" />
          </Border>
        </Grid>
      </Border>

      <!-- Telemetry & Recognized Lines Sidebar -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Diagnostics Telemetry Card -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="YAKALAMA &amp; OCR TELEMETRİSİ" Style="{StaticResource Text.Label}" Margin="0,0,0,10" />

            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Sağlayıcı:" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" />
              <TextBlock Grid.Column="1" AutomationProperties.AutomationId="Text_Provider"
                         Text="{Binding ProviderName}" FontSize="12" />
            </Grid>

            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Durum:" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" />
              <TextBlock Grid.Column="1" AutomationProperties.AutomationId="Text_Status"
                         Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Brush.Accent}" />
            </Grid>

            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Çözünürlük:" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" />
              <TextBlock Grid.Column="1" AutomationProperties.AutomationId="Text_Resolution"
                         Text="{Binding ResolutionText}" FontSize="12" />
            </Grid>

            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Yakalama FPS:" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" />
              <TextBlock Grid.Column="1" AutomationProperties.AutomationId="Text_Fps"
                         Text="{Binding Fps, StringFormat='{}{0:F1}'}" FontSize="12" />
            </Grid>

            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Yakalama Gecikmesi:" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" />
              <TextBlock Grid.Column="1" AutomationProperties.AutomationId="Text_CaptureLatency"
                         Text="{Binding CaptureLatencyMs, StringFormat='{}{0:F1} ms'}" FontSize="12" />
            </Grid>

            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="OCR Gecikmesi:" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" />
              <TextBlock Grid.Column="1" AutomationProperties.AutomationId="Text_OcrLatency"
                         Text="{Binding OcrLatencyMs, StringFormat='{}{0:F1} ms'}" FontSize="12" />
            </Grid>

            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Kare Tazeliği:" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" />
              <TextBlock Grid.Column="1" AutomationProperties.AutomationId="Text_FreshFrameAge"
                         Text="{Binding FreshFrameAgeText}" FontSize="12" Foreground="{StaticResource Brush.Accent}" />
            </Grid>

            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Bellek (WorkingSet):" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" />
              <TextBlock Grid.Column="1" AutomationProperties.AutomationId="Text_Memory"
                         Text="{Binding MemoryMb, StringFormat='{}{0:F1} MB'}" FontSize="12" />
            </Grid>

            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="İşlenen / Atlanan Kare:" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" />
              <TextBlock Grid.Column="1" AutomationProperties.AutomationId="Text_DroppedFrames"
                         Text="{Binding DroppedFramesCount, StringFormat='Atlanan: {0}'}" FontSize="11" Foreground="{StaticResource Brush.TextMuted}" />
            </Grid>

            <TextBlock AutomationProperties.AutomationId="Text_LastCaptureError"
                       Text="{Binding LastCaptureError}" Foreground="#FF6B6B" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
            <TextBlock AutomationProperties.AutomationId="Text_LastOcrError"
                       Text="{Binding LastOcrError}" Foreground="#FF6B6B" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- Recognized Text List Card -->
        <Border Grid.Row="1" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1" CornerRadius="4" Padding="14">
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Top" Text="TESPİT EDİLEN ALTYAZI METİNLERİ" Style="{StaticResource Text.Label}" Margin="0,0,0,8" />
            
            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Text.Label}" FontSize="11" Foreground="{StaticResource Brush.TextMuted}"
                       Text="* Not: Bu aşamada sadece İngilizce metin tanıma yapılmaktadır. Çeviri AG-03 aşamasındadır."
                       Margin="0,8,0,0" TextWrapping="Wrap" />

            <ListBox AutomationProperties.AutomationId="List_RecognizedLines"
                     ItemsSource="{Binding RecognizedLines}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vision:OcrTextLine}">
                  <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,6" Margin="0,2">
                    <StackPanel>
                      <TextBlock Text="{Binding Text}" Foreground="{StaticResource Brush.TextPrimary}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Border Background="{StaticResource Brush.SurfaceRaised}" CornerRadius="2" Padding="4,1" Margin="0,0,6,0">
                          <TextBlock Text="{Binding ConfidenceText}" FontSize="10" Foreground="{StaticResource Brush.Accent}" />
                        </Border>
                        <TextBlock Text="{Binding Bounds, StringFormat='Konum: {0}'}" FontSize="10" Foreground="{StaticResource Brush.TextMuted}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- ===== Status Footer ===== -->
    <Border Grid.Row="2" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,10,0,0">
      <StackPanel>
        <TextBlock AutomationProperties.AutomationId="Text_StatusMessage"
                   Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}" />
        <TextBlock AutomationProperties.AutomationId="Text_BenchmarkSummary"
                   Text="{Binding BenchmarkSummary}" FontSize="11" Foreground="{StaticResource Brush.Accent}" Margin="0,4,0,0"
                   Visibility="{Binding HasBenchmarkSummary, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
