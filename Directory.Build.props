<Project>
  <!-- Shared build settings for every project in the Subviora solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML comment for publicly visible member. Documentation is encouraged, not mandatory. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>en;tr</SatelliteResourceLanguages>

    <Product>Subviora</Product>
    <Company>Subviora</Company>
    <Copyright>Copyright Â© Subviora. All rights reserved.</Copyright>
    <Version>0.2.0</Version>
    <InformationalVersion>0.2.0-ag02</InformationalVersion>
    <NeutralLanguage>tr-TR</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>

